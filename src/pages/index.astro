---
import "../styles/global.css";

const name = "Natasha Sharan";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Personal website of Natasha Sharan." />
    <title>{name}</title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/">Natasha Sharan</a>

        <div>
          <a href="#about">About</a>
          <a href="#research">Research</a>
          <a href="#projects">Projects</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section>
        <p>Computer Science · Machine Learning · Computer Vision</p>

        <h1>Hi, I'm Natasha.</h1>

        <p>
          I'm a Computer Science graduate from the University of Toronto
          interested in machine learning, computer vision, deep learning,
          and AI systems.
        </p>

        <div>
          <a href="https://github.com/n-sharan">GitHub</a>
          <a href="https://www.linkedin.com/">LinkedIn</a>
          <a href="/resume.pdf">Resume</a>
        </div>
      </section>

      <section id="about">
        <h2>About</h2>

        <p>
          I'm interested in developing and evaluating AI systems, with a
          particular focus on computer vision, deep learning, and multimodal
          learning.
        </p>
      </section>

      <section id="research">
        <h2>Research</h2>

        <article>
          <h3>Reinforcement Learning for Medical VLMs</h3>
          <p>
            Research exploring the effects of supervised fine-tuning and
            reinforcement learning on medical vision-language models.
          </p>
        </article>

        <article>
          <h3>Occlusion-Aware Object Detection</h3>
          <p>
            Research on unsupervised object detection and maintaining object
            identity under occlusion.
          </p>
        </article>
      </section>

      <section id="projects">
        <h2>Projects</h2>

        <article>
          <h3>AI Evaluation Platform</h3>
          <p>
            A configurable platform for evaluating LLMs and VLMs across
            different capabilities and benchmarks.
          </p>
        </article>

        <article>
          <h3>Agentic AI Evaluation</h3>
          <p>
            Exploring agentic workflows for experiment configuration,
            monitoring, failure analysis, and recovery.
          </p>
        </article>

        <article>
          <h3>MERN To-Do Application</h3>
          <p>
            A full-stack web application built with MongoDB, Express,
            React, and Node.js.
          </p>
        </article>
      </section>

      <section id="contact">
        <h2>Contact</h2>

        <p>
          Feel free to reach out if you'd like to discuss research,
          machine learning, or software engineering.
        </p>
      </section>
    </main>

    <footer>
      <p>© 2026 Natasha Sharan</p>
    </footer>
  </body>
</html>
